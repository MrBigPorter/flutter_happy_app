# JoyMini Web _headers — Cloudflare Pages / Netlify
# https://developers.cloudflare.com/pages/configuration/headers/

# ── Default: Security Headers ──────────────────────────────────────────────────
/*
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Opener-Policy: same-origin

# ── HTML: Always fresh (PWA needs SW to check for updates) ────────────────────
/index.html
  Cache-Control: public, no-cache, must-revalidate
  Content-Type: text/html; charset=utf-8

# ── Offline & Manifest: Not content-hashed, must be fresh ─────────────────────
/offline.html
  Cache-Control: public, no-cache, must-revalidate
/manifest.json
  Cache-Control: public, no-cache, must-revalidate

# ── Service Worker: MUST NOT be cached (browser checks SW on every navigation) ─
/pwa_sw.js
  Cache-Control: public, no-cache, must-revalidate
/flutter_service_worker.js
  Cache-Control: public, no-cache, must-revalidate

# ── Bootstrap Loader: Changes per build (contains serviceWorkerVersion) ──────
# flutter_bootstrap.js is auto-generated by `flutter build web` with a different
# serviceWorkerVersion per build. Must NOT be cached long-term — otherwise the
# browser loads the old serviceWorkerVersion, which points to a non-existent
# flutter_service_worker.js?v=OLD_VERSION (deleted on rebuild).
/flutter_bootstrap.js
  Cache-Control: public, no-cache, must-revalidate

# ── Flutter Engine Loader: Could change with Flutter SDK updates ────────────
/flutter.js
  Cache-Control: public, no-cache, must-revalidate

# ── Main App Code: Changes per build (not content-hashed) ───────────────────
# main.dart.js filename is fixed. Content changes every build.
# Browser revalidates with 304 Not Modified when unchanged — no full re-download.
/main.dart.js
  Cache-Control: public, no-cache, must-revalidate

# ── Flutter Engine Assets: Content-hashed or versioned filenames (immutable) ─
# .part.js chunks have stable chunk-number IDs; *.wasm and SDK assets use
# content hashes. Safe to cache long-term since old filenames are never re-used.
*.js
*.mjs
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

# ── WebAssembly (canvaskit.wasm, main.dart.wasm): Immutable ──────────────────
*.wasm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm

# ── Fonts: Immutable ──────────────────────────────────────────────────────────
*.ttf
*.woff
*.woff2
  Cache-Control: public, max-age=31536000, immutable

# ── Static Icons: Versioned in manifest, safe to cache long-term ──────────────
/icons/*
/favicon.png
/app_icon.png
  Cache-Control: public, max-age=31536000, immutable

# ── API Responses: Never cache in browser (SW handles API caching) ────────────
/api/*
  Cache-Control: public, no-cache, must-revalidate
